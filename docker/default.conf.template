# Saldenwerk: statische Auslieferung der App.
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    charset utf-8;
    charset_types text/css application/javascript;

    # Textressourcen komprimieren (woff2 ist bereits komprimiert).
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript image/svg+xml application/json;

    include /etc/nginx/includes/security-headers.conf;

    # App-Dateien immer revalidieren (verhindert Alt/Neu-Mischstaende nach
    # Updates); die grossen vendor-Bibliotheken duerfen lange cachen.
    # Hinweis: bei einem vendor-Update Dateinamen versionieren oder die
    # immutable-Regel lockern — Clients cachen ein Jahr.
    location ~* \.(html|css|js)$ {
        add_header Cache-Control "no-cache";
        include /etc/nginx/includes/security-headers.conf;
    }
    location ^~ /vendor/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/includes/security-headers.conf;
    }

    # Optionale Rechen-Schnittstelle (zweiter Container, Compose-Profil "api").
    #
    # ACHTUNG, envsubst-Falle: Ist SALDENWERK_API_URL in der Umgebung des
    # nginx-Containers NICHT gesetzt, laesst envsubst den Platzhalter unten
    # woertlich stehen, nginx sieht eine unbekannte Variable und startet gar
    # nicht mehr — die ganze Kanzlei haette dann kein Saldenwerk. Deshalb ist
    # die Variable in docker-compose.yml IMMER definiert, notfalls leer.
    # Leer bedeutet: 404, die Schnittstelle ist sauber aus.
    # Der CI-Job "compose-ohne-profil" prueft genau das bei jedem Commit.
    location /api/ {
        resolver 127.0.0.11 ipv6=off valid=30s;
        set $api "${SALDENWERK_API_URL}";
        if ($api = "") { return 404; }

        # proxy_pass mit Variable reicht die Anfrage-URI unveraendert weiter —
        # der Server routet selbst auf /api/..., das ist so gewollt.
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Muss zum 10-MB-Limit des Servers passen; der nginx-Default von 1 MB
        # wuerde groessere Bestaende abschneiden.
        client_max_body_size 10m;
        proxy_read_timeout 90s;

        # Anfragen an /api/ tragen Aktenbezug im Query-String (?kontoId=).
        # Der nginx-Default wuerde ihn mitprotokollieren — damit landeten
        # Bezeichner aus Mandatsakten in Logdateien, waehrend datenschutz.html
        # das Gegenteil zusichert.
        access_log off;

        include /etc/nginx/includes/security-headers.conf;
    }
}
