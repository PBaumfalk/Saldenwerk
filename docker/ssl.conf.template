# Optionaler HTTPS-Server-Block. Aktivierung über docker-compose.yml:
# diese Datei nach /etc/nginx/templates/ mounten und Zertifikate nach
# /etc/nginx/certs/ (tls.crt + tls.key). HTTPS ist Voraussetzung dafür,
# dass die Datei-Speicherung (File System Access API) im LAN funktioniert.
server {
    listen 443 ssl;
    http2 on;
    ssl_certificate /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    charset utf-8;
    charset_types text/css application/javascript;

    # Textressourcen komprimieren (woff2 ist bereits komprimiert).
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript image/svg+xml application/json;

    include /etc/nginx/includes/security-headers.conf;

    # App-Dateien immer revalidieren (verhindert Alt/Neu-Mischstaende nach
    # Updates); die grossen vendor-Bibliotheken duerfen lange cachen.
    location ~* \.(html|css|js)$ {
        add_header Cache-Control "no-cache";
        include /etc/nginx/includes/security-headers.conf;
    }
    location ^~ /vendor/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/includes/security-headers.conf;
    }
}
